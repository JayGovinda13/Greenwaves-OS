# PostgreSQL. Local: "npm run db:up" (docker compose) usa a URL abaixo.
# No Vercel: conecte um banco Neon (Storage → Neon) — ele cria DATABASE_URL automaticamente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greenwaves"
# Segredo para assinar a sessão (gere com: openssl rand -base64 32). Obrigatório também no Vercel.
AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"
# Página "Agende uma demo" (/demo): canais de contato. Configure pelo menos um.
# WhatsApp com DDI e DDD, só números (ex.: 5511999999999)
DEMO_WHATSAPP=""
DEMO_EMAIL=""
# LGPD — dados da plataforma exibidos na Política de Privacidade (/privacidade)
PLATFORM_LEGAL_NAME=""
PLATFORM_CNPJ=""
PRIVACY_EMAIL=""
PLATFORM_DPO_NAME=""
# Chave para criptografar RG/CPF no banco (se vazia, deriva de AUTH_SECRET). Não troque depois de usar.
DATA_ENCRYPTION_KEY=""
# URL pública (links do conector MCP)
APP_URL=""
