// Greenwaves OS — modelo de dados multi-tenant.
// Toda entidade de negócio pertence a uma Organization (tenant) e é sempre
// consultada com filtro por organizationId (ver src/lib/tenant.ts).
//
// Valores monetários são armazenados em centavos (Int) para evitar erros de ponto flutuante.
// Campos de "enum" são String validados com zod (src/lib/domain.ts).
// Banco: PostgreSQL (local via docker-compose; produção via Neon/Vercel Marketplace).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  plan          String    @default("PRO") // FREE | PRO | ENTERPRISE
  email         String?
  phone         String?
  instagram     String?
  city          String?
  // Integração com IA (MCP): só funciona após aceite explícito de um(a) sócio(a) (LGPD: transparência e responsabilização)
  // LGPD: encarregado(a) pelo tratamento de dados pessoais desta produtora (art. 41)
  dpoName       String?
  dpoEmail      String?
  aiEnabled     Boolean   @default(false)
  aiEnabledAt   DateTime?
  aiEnabledById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships  Membership[]
  artists      Artist[]
  shows        Show[]
  contacts     Contact[]
  transactions Transaction[]
  activities   Activity[]
  tasks        Task[]
  apiTokens    ApiToken[]
  mcpLogs      McpAuditLog[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  activities    Activity[]
  showsOwned    Show[]         @relation("ShowOwner")
  tasksAssigned Task[]         @relation("TaskAssignee")
  tasksCreated  Task[]         @relation("TaskCreator")
  ticketReports TicketReport[]
  apiTokens     ApiToken[]
  mcpLogs       McpAuditLog[]
}

model Membership {
  id             String       @id @default(cuid())
  role           String       @default("PRODUCER") // OWNER | ADMIN | PRODUCER | VIEWER
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Artist {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  slug              String
  instagram         String?
  originCity        String?
  originState       String?
  genres            String? // separado por vírgula
  bio               String?
  latestRelease     String?
  label             String?
  mediaKitUrl       String?
  riderUrl          String?
  photosUrl         String?
  settlementUrl     String? // planilha de fechamento
  baseFee           Int? // cachê de referência (centavos)
  hospitalityLocal  String? // contrapartidas padrão na própria UF (códigos separados por vírgula)
  hospitalityTravel String? // contrapartidas padrão quando viaja para outra UF
  techRider         Json? // modelo de ficha técnica do artista (ver src/lib/techRider.ts)
  accent            String   @default("green") // green | lime | cream (estilo do card)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ArtistMember[]
  shows        Show[]
  transactions Transaction[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// "Dados das bandas": integrantes e equipe técnica de cada artista
model ArtistMember {
  id           String    @id @default(cuid())
  artistId     String
  name         String
  role         String?
  birthDate    DateTime?
  documentRg   String?
  documentCpf  String?
  phone        String?
  email        String?
  restrictions String? // preferências/restrições alimentares, rider pessoal etc.
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

// Contratantes, casas de show, festivais e coletivos
model Contact {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  company        String? // Casa / Fest / Coletivo
  kind           String   @default("VENUE") // VENUE | FESTIVAL | COLLECTIVE | PRODUCER | PRESS | SUPPLIER | OTHER
  region         String?
  state          String?
  city           String?
  phone          String?
  email          String?
  instagram      String?
  link           String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shows        Show[]

  @@index([organizationId])
  @@index([organizationId, state])
}

model Show {
  id               String   @id @default(cuid())
  organizationId   String
  artistId         String
  contactId        String?
  ownerId          String?
  date             DateTime
  city             String?
  state            String?
  venue            String?
  venueUrl         String? // link do mapa da casa
  venueAddress     String? // endereço da casa (roadbook)
  lodgingName      String? // hotel/hospedagem
  lodgingAddress   String?
  techRider        Json? // ficha técnica personalizada para este show (null = usa o modelo do artista)
  venueTechContact String? // técnico de som / contato técnico da casa
  techNotes        String? // observações técnicas deste show
  eventName        String?
  status           String   @default("CONFIRMED") // PROSPECT | NEGOTIATING | CONFIRMED | DONE | CANCELED
  contactName      String? // contato livre quando não há Contact cadastrado

  // Combinado (deal)
  dealType         String    @default("FIXED") // FIXED | DOOR | GUARANTEE_OR_DOOR | FREE | TBD
  fee              Int? // cachê/garantia em centavos
  doorPercent      Int? // % de bilheteria
  dealNotes        String? // texto original do combinado
  hospitality      String? // contrapartidas: códigos separados por vírgula (HOSPITALITY em domain.ts)
  hospitalityNotes String? // observações livres sobre contrapartidas
  paymentTerms     String    @default("ON_SITE") // ON_SITE (no ato/dia do show) | SCHEDULED (data combinada)
  paymentDueDate   DateTime? // vencimento quando SCHEDULED

  // Bilheteria / divulgação
  ticketUrl        String?
  ticketsSold      Int?
  ticketsUpdatedAt DateTime? // última atualização de vendas
  capacity         Int?
  ticketPrice      Int? // centavos
  posterUrl        String?
  socialUrl        String?

  // Pré-produção e logística
  techSheetUrl String? // ficha técnica / caderno técnico
  travel       String? // passagens
  lodging      String? // hospedagem
  crewList     String? // lista de equipe
  guestList    String? // lista de convidados
  notes        String?

  // Checklist de produção
  chkPoster    Boolean @default(false)
  chkTickets   Boolean @default(false)
  chkTechSheet Boolean @default(false)
  chkSocial    Boolean @default(false)
  chkTravel    Boolean @default(false)
  chkLodging   Boolean @default(false)
  chkCrewList  Boolean @default(false)
  chkGuests    Boolean @default(false)
  chkSettled   Boolean @default(false) // fechamento/acerto realizado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  artist        Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  contact       Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner         User?              @relation("ShowOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  transactions  Transaction[]
  tasks         Task[]
  ticketReports TicketReport[]
  scheduleItems ShowScheduleItem[]

  @@index([organizationId, date])
  @@index([artistId])
}

// Lançamentos financeiros: cachês a receber, comissões, despesas (cartão Green Wave), repasses
model Transaction {
  id             String    @id @default(cuid())
  organizationId String
  showId         String?
  artistId       String?
  type           String // INCOME | EXPENSE
  category       String // FEE | COMMISSION | TICKETING | TRAVEL | LODGING | FOOD | BACKLINE | MARKETING | CARD | PAYOUT | OTHER
  description    String
  amount         Int // centavos, sempre positivo
  date           DateTime
  dueDate        DateTime?
  status         String    @default("PENDING") // PENDING | PAID | CANCELED
  method         String? // PIX | CARD | TRANSFER | CASH | BOLETO
  source         String? // SHOW_FEE = recebível gerado automaticamente pelo show
  paidAt         DateTime? // quando foi efetivamente pago (adimplência)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  show         Show?        @relation(fields: [showId], references: [id], onDelete: SetNull)
  artist       Artist?      @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
}

// Trilha de auditoria
model Activity {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // created | updated | deleted | imported ...
  entity         String // show | artist | contact | transaction | member ...
  entityId       String?
  summary        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// Tarefas da equipe: criadas e delegadas pelo cabeçalho do sistema
model Task {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         String    @default("TODO") // TODO | DONE
  priority       String    @default("NORMAL") // LOW | NORMAL | HIGH
  dueDate        DateTime?
  assigneeId     String?
  creatorId      String?
  showId         String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User?        @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  show         Show?        @relation(fields: [showId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([assigneeId, status])
}

// Histórico de vendas de ingressos informadas manualmente (ou por importação)
model TicketReport {
  id           String   @id @default(cuid())
  showId       String
  sold         Int
  source       String   @default("MANUAL") // PLATFORM | PROMOTER | ESTIMATE | IMPORT | MANUAL
  note         String?
  reportedById String?
  reportedAt   DateTime @default(now())

  show       Show  @relation(fields: [showId], references: [id], onDelete: Cascade)
  reportedBy User? @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([showId, reportedAt])
}

// Roteiro do dia (roadbook): embarque, check-in, passagem de som, show, check-out...
model ShowScheduleItem {
  id        String   @id @default(cuid())
  showId    String
  kind      String   @default("OTHER") // ver SCHEDULE_KINDS em domain.ts
  day       String // YYYY-MM-DD (horário local do evento)
  time      String // HH:mm
  title     String?
  location  String?
  notes     String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([showId, day, time])
}

// Chaves pessoais para conectar o Claude (MCP). Guardamos só o hash; a chave aparece uma única vez.
model ApiToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  name           String
  prefix         String // primeiros caracteres, para identificar a chave na tela
  tokenHash      String    @unique // SHA-256 da chave
  scope          String    @default("READ") // READ | WRITE
  expiresAt      DateTime
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs         McpAuditLog[]

  @@index([organizationId])
  @@index([userId])
}

// Registro das operações feitas via Claude (LGPD art. 37). Não guarda o conteúdo dos dados pessoais.
model McpAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  tokenId        String?
  tool           String
  ok             Boolean  @default(true)
  summary        String? // ex.: "show cmx… atualizado" — sem dados pessoais
  personalData   Boolean  @default(false) // a resposta incluiu dados pessoais de terceiros (ex.: telefone de contratante)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  token        ApiToken?    @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([tokenId, createdAt])
}

// Tentativas de login malsucedidas (proteção contra força bruta — LGPD art. 46). Guardamos só o hash do e-mail.
model LoginAttempt {
  id        String   @id @default(cuid())
  emailHash String
  ip        String?
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
}
